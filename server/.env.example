PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://user:password@localhost:5432/intervueai
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
MAX_FILE_SIZE_MB=5
CORS_ORIGIN=http://localhost:5173
AUTH_RATE_LIMIT_MAX=100
INTERVIEW_ADMIN_API_KEY=replace_with_a_strong_internal_api_key
PUBLIC_APP_URL=http://localhost:5173
MAIL_FROM=noreply@intervueai.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=15000
SMTP_SEND_TIMEOUT_MS=15000
INVITE_EMAIL_RETRY_INTERVAL_MS=300000
INVITE_EMAIL_RETRY_BATCH_SIZE=25

# Required: Cloudinary for resume storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_RESUME_FOLDER=intervueai/resumes

# ElevenLabs TTS configuration
ELEVENLABS_API_KEY=

# Optional: if empty, server auto-selects first available voice from your ElevenLabs account
ELEVENLABS_VOICE_ID=

# Optional tuning
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_STABILITY=0.35
ELEVENLABS_SIMILARITY_BOOST=0.9
ELEVENLABS_STYLE=0.05
ELEVENLABS_SPEAKER_BOOST=true
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128