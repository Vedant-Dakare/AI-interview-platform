generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum CandidateRole {
  backend
  ml
  dsa
}

enum InviteStatus {
  pending
  completed
}

model User {
  id         Int         @id @default(autoincrement())
  name       String
  email      String      @unique
  password   String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  resumes    Resume[]
  interviews Interview[]
}

model Resume {
  id            Int      @id @default(autoincrement())
  userId        Int
  fileUrl       String
  extractedText String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Interview {
  id                   Int              @id @default(autoincrement())
  userId               Int
  role                 String
  currentQuestionIndex Int              @default(0)
  status               String           @default("started")
  warningCount         Int              @default(0)             @map("warning_count")
  isTerminated         Boolean          @default(false)         @map("is_terminated")
  terminationReason    String?          @map("termination_reason")
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  questions            Question[]
  answers              Answer[]
  proctoredEvents      ProctoredEvent[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model Question {
  id           Int      @id @default(autoincrement())
  interviewId  Int
  roleQuestionId Int?
  questionText String
  orderIndex   Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  answer       Answer?

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  roleQuestion RoleQuestion? @relation(fields: [roleQuestionId], references: [id], onDelete: SetNull)

  @@unique([interviewId, orderIndex])
  @@index([interviewId])
  @@index([roleQuestionId])
}

model Answer {
  id              Int      @id @default(autoincrement())
  interviewId     Int      @map("interview_id")
  questionId      Int      @unique
  answerText      String   @map("answer_text")
  embeddingVector Json?    @map("embedding_vector")
  similarityScore Float?   @map("similarity_score")
  llmScore        Float?   @map("llm_score")
  finalScore      Float?   @map("final_score")
  score           Float?
  feedback        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  question  Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([interviewId])
}

model RoleQuestion {
  id          Int           @id @default(autoincrement())
  role        CandidateRole
  questionText String       @map("question_text")
  idealAnswer String        @map("ideal_answer")
  orderIndex  Int           @map("order_index")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  questions   Question[]

  @@unique([role, orderIndex])
  @@map("role_questions")
}

model Candidate {
  id                Int             @id @default(autoincrement())
  candidateId       String          @unique @default(uuid()) @map("candidate_id")
  fullName          String          @map("full_name")
  email             String
  role              CandidateRole
  resumeFileUrl     String?         @map("resume_file_url")
  resumeInsights    String?         @map("resume_insights")
  applicationStatus String          @default("submitted") @map("application_status")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  invites           InterviewInvite[]

  @@index([email])
  @@index([role])
  @@map("candidates")
}

model InterviewInvite {
  id                 Int           @id @default(autoincrement())
  candidateRecordId  Int?          @map("candidate_record_id")
  candidateId        String        @unique @map("candidate_id")
  email              String
  role               CandidateRole
  interviewTokenHash String?       @unique @map("interview_token_hash")
  tokenExpiry        DateTime      @map("token_expiry")
  status             InviteStatus  @default(pending)
  resumeInsights     String?       @map("resume_insights")
  questionPlan       Json?         @map("question_plan")
  startedAt          DateTime?     @map("started_at")
  completedAt        DateTime?     @map("completed_at")
  emailSentAt        DateTime?     @map("email_sent_at")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  candidate Candidate? @relation(fields: [candidateRecordId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([status])
  @@index([tokenExpiry])
  @@index([candidateRecordId])
  @@map("interview_invites")
}

model ProctoredEvent {
  id         Int      @id @default(autoincrement())
  interviewId Int      @map("interview_id")
  eventType  String   @map("event_type")
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@index([interviewId])
  @@index([eventType])
  @@map("proctor_events")
}
