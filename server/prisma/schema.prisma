generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum CandidateRole {
  backend
  ml
  dsa
}

enum InviteStatus {
  pending
  completed
}

model User {
  id         Int         @id @default(autoincrement())
  name       String
  email      String      @unique
  password   String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  resumes    Resume[]
  interviews Interview[]
}

model Resume {
  id            Int      @id @default(autoincrement())
  userId        Int
  fileUrl       String
  extractedText String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Interview {
  id                   Int        @id @default(autoincrement())
  userId               Int
  role                 String
  currentQuestionIndex Int        @default(0)
  status               String     @default("started")
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  questions            Question[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model Question {
  id           Int      @id @default(autoincrement())
  interviewId  Int
  questionText String
  orderIndex   Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  answer       Answer?

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@unique([interviewId, orderIndex])
  @@index([interviewId])
}

model Answer {
  id         Int      @id @default(autoincrement())
  questionId Int      @unique
  answerText String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model InterviewInvite {
  id                 Int           @id @default(autoincrement())
  candidateId        String        @unique @map("candidate_id")
  email              String
  role               CandidateRole
  interviewTokenHash String?       @unique @map("interview_token_hash")
  tokenExpiry        DateTime      @map("token_expiry")
  status             InviteStatus  @default(pending)
  resumeInsights     String?       @map("resume_insights")
  questionPlan       Json?         @map("question_plan")
  startedAt          DateTime?     @map("started_at")
  completedAt        DateTime?     @map("completed_at")
  emailSentAt        DateTime?     @map("email_sent_at")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  @@index([email])
  @@index([status])
  @@index([tokenExpiry])
  @@map("interview_invites")
}
